import random
print("=== Coin Toss Simulator ===")
while True:
    choice = input("Toss the coin? (yes/no): ").lower()
    if choice == "yes":
        result = random.choice(["Heads", "Tails"])
        print("Result:", result)
    elif choice == "no":
        print("Thanks for playing!")
        break
    else:
        print("Please enter yes or no.")


